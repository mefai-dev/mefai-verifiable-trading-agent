# MEFAI Verifiable Trading Agent · example environment
# Copy to `.env` and fill in your own values. NEVER commit a real `.env`.
# The agent ships in PAPER mode: it decides, gates, sizes, plans and publishes
# its live state but signs NOTHING until you explicitly opt in below.

# ── Execution mode (opt-in, default OFF = paper) ────────────────────────────
# Spot trades on a DEX. Leave unset/0 for paper.
BNBHACK_EXECUTE_TRADES=0
# Verifiable chain writes (commit-reveal + equity anchor). Leave unset/0 for paper.
BNBHACK_EXECUTE_CHAIN=0
# Live SHORT leg via the gated USDT-M futures adapter (perp_exec, Binance-first).
# Leave unset/0 for paper · a live short is an honest no-go until this is on AND
# venue keys are set below.
BNBHACK_EXECUTE_PERP=0

# ── Signing keys (REQUIRED only when an execute flag is on) ─────────────────
# Hot wallet that signs swaps and chain writes. Keep this OUT of version control.
BNBHACK_AGENT_PRIVATE_KEY=
# Oracle/keeper key that feeds the on-chain RiskGovernor equity.
BNBHACK_ORACLE_PRIVATE_KEY=
# Legacy alias accepted if the oracle key above is unset.
ARENA_ORACLE_PRIVATE_KEY=

# ── Public identity (safe to share · these are verification anchors) ────────
# The agent's public wallet address (holds the on-chain identity).
TWAK_AGENT_WALLET=
# ERC-8004 agent id (the 32-byte identity hash) and registry address.
BNBHACK_AGENT_ID=
ERC8004_REGISTRY_ADDRESS=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
MEFAI_MAINNET_LEDGER=
# Commit-reveal registry + RiskGovernor, selected by BNBHACK_CHAIN_ID below.
# The mainnet pair (judged window) is public, so the real addresses are safe to ship.
BNBHACK_REGISTRY_MAINNET=0xcA9499a2d20cFAa98f9Bc3b2F1386A70f51c2FEB
BNBHACK_RISKGOVERNOR_MAINNET=0xFACBc0a9b5a7dd34BfD0B91e1102dF4E72b9e43f
# The chain-97 testnet pair (only used for keyless local runs on chain 97).
BNBHACK_REGISTRY_TESTNET=
BNBHACK_RISKGOVERNOR_TESTNET=

# ── Chain / RPC ─────────────────────────────────────────────────────────────
# 56 = BSC mainnet (judged window) · 97 = BSC testnet for keyless local runs.
BNBHACK_CHAIN_ID=56
# Primary RPC and an optional comma-separated failover list.
BNBHACK_RPC_URL=https://bsc-rpc.publicnode.com
BNBHACK_RPC_URLS=
ARENA_RPC_URL=

# ── Decision loop ───────────────────────────────────────────────────────────
BNBHACK_TIMEFRAME=5m
BNBHACK_HORIZON=24h
BNBHACK_LOOP_INTERVAL=60
BNBHACK_CONVICTION_MIN=35
BNBHACK_INCLUDE_CMC=1
BNBHACK_REGIME_FILTER=1
# Stand aside when risk-off conviction is at least this strong. Strength is
# normalized to 0..1 (abs(FearGreed-50)/50), so values above 1.0 never trigger.
BNBHACK_REGIME_BLOCK_STRENGTH=0.5
# Skip any signal older than this many timeframe bars (stale = never acted on).
BNBHACK_SIGNAL_MAX_AGE_BARS=8
# Starting mark-to-market equity used by the loop before the first fill.
BNBHACK_EQUITY=1000
# Log verbosity for the loop and watchdog (DEBUG/INFO/WARNING/ERROR).
BNBHACK_LOG_LEVEL=INFO

# ── Risk / sizing (drawdown-budgeted fractional Kelly) ──────────────────────
BNBHACK_START_EQUITY_USD=1000
# Max-drawdown disqualification threshold (jury rule), as a fraction of equity.
# 0.20 = the 2000 bps DQ cap; the agent's own internal stop sizes to 0.7x of this
# (1400 bps), matching the on-chain RiskGovernor maxDrawdownBps so the agent halts
# before the jury cap is ever reached.
BNBHACK_JURY_CAP=0.20
BNBHACK_MAX_POSITIONS=3
BNBHACK_LADDER_RUNGS=1
BNBHACK_MAX_HOLD_SEC=86400
BNBHACK_ROUNDTRIP_COST_PCT=0.2
BNBHACK_MIN_EDGE_SAMPLES=30
BNBHACK_EDGE_STDERR_MULT=1.0
BNBHACK_SLIPPAGE_PCT=0.5
BNBHACK_TP1_PCT=50
BNBHACK_TP1_MIN_GAIN_PCT=1.0
BNBHACK_TP2_MULT=2.0
BNBHACK_TRAIL_ARM_PCT=2.0
BNBHACK_TRAIL_LOCK_PCT=1.0
BNBHACK_PROFIT_LOCK_PCT=1.0
BNBHACK_STUCK_CLOSE_ALERT=3

# ── Daily trade floor (>=1 trade/day rule) ──────────────────────────────────
# Force a minimal trade late in the UTC day if none happened, to satisfy the
# jury's >=1 trade/day rule. Never trades through a drawdown halt.
BNBHACK_DAILY_TRADE_FLOOR=1
# Minimum number of trades required per UTC day.
BNBHACK_DAILY_MIN_TRADES=1
# UTC hour after which the relaxed floor pass may force an eligible LONG.
BNBHACK_DAILY_FLOOR_HOUR_UTC=21
# UTC hour for the last-resort floor: places ONE minimal swap on the most
# liquid routable base, bypassing only the selectivity gates (security + halt
# checks still run).
BNBHACK_DAILY_FLOOR_LASTRESORT_HOUR_UTC=23
# Notional (USD) of a forced floor trade · small, just enough to satisfy the rule.
BNBHACK_DAILY_FLOOR_USD=8
# File tracking which UTC days have already met the floor.
BNBHACK_DAILY_TRADE_FILE=data/daily_trades.json

# ── Reveal scheduling (commit-reveal proof trail) ───────────────────────────
# Seconds to wait after a commit before revealing.
BNBHACK_REVEAL_AFTER=90
# Max reveal retries before giving up on a single commit.
BNBHACK_REVEAL_MAX_ATTEMPTS=4
# Max reveals attempted per loop cycle (rate limits chain writes).
BNBHACK_REVEAL_CYCLE_BUDGET=30
# Days to keep pending commit rows on disk before pruning.
BNBHACK_PENDING_RETENTION_DAYS=14

# ── On-chain equity anchor ──────────────────────────────────────────────────
# Seconds between RiskGovernor equity-anchor writes.
BNBHACK_CHAIN_EQUITY_INTERVAL=300
# Baseline equity (bps reference) reported to the on-chain RiskGovernor.
BNBHACK_CHAIN_EQUITY_BASELINE=100000
# Fold open-position unrealized PnL into equity (mark-to-market) when 1.
BNBHACK_MARK_TO_MARKET=0
# Chain tx send budget and per-tx timeout (seconds).
BNBHACK_TX_SEND_BUDGET=45
BNBHACK_TX_TIMEOUT=25
# Optional explicit registry/governor addresses (override the chain-id pair above).
BNBHACK_REGISTRY_ADDR=
BNBHACK_RISKGOVERNOR_ADDR=

# ── Execution safety caps ───────────────────────────────────────────────────
BSC_MAX_SWAP_USD=250
BSC_MAX_TRANSFER_USD=250
BNBHACK_GAS_GWEI=
BNBHACK_GAS_LIMIT=

# ── Perp SHORT venue (USDT-M futures, used only when BNBHACK_EXECUTE_PERP=1) ──
# Venue API credentials · leave blank to keep the live short an honest no-go.
BNBHACK_PERP_KEY=
BNBHACK_PERP_SECRET=
# Venue selector (Binance-first), quote asset, margin mode, leverage, testnet.
BNBHACK_PERP_VENUE=binance
BNBHACK_PERP_QUOTE=USDT
BNBHACK_PERP_MARGIN_MODE=isolated
BNBHACK_PERP_LEVERAGE=1
BNBHACK_PERP_TESTNET=0

# ── Data sources (local read-only databases) ────────────────────────────────
# Labeled-outcome history that the sizing engine fits its edge on.
MEFAI_SIGNAL_DB=data/signal.db
MEFAI_SKILLS_DB=data/mefai_skills.db
MEFAI_KRONOS_DB=data/predictions.db
BNBHACK_LOOP_DB=data/loop.db
BNBHACK_POSITION_DB=data/positions.db
BNBHACK_LOOP_STATE=state/loop_state.json
BNBHACK_PEAK_EQUITY_FILE=data/peak_equity.json
BNBHACK_START_EQUITY_FILE=data/start_equity.json

# ── Public service URLs (presentation only) ─────────────────────────────────
MEFAI_SITE=https://mefai.io
MEFAI_PROXY_URL=http://127.0.0.1:8210
# All default to paths under MEFAI_SITE; override only for a different deployment.
MEFAI_COCKPIT_URL=
MEFAI_LEADERBOARD_URL=
MEFAI_X402_URL=
MEFAI_AGENT_CARD_URL=
MEFAI_LOGO_URL=

# ── API edge (compute POST routes are referer-gated; read endpoints stay open) ─
BNBHACK_API_KEY=
BNBHACK_TRUSTED_PROXIES=127.0.0.1,::1
BNBHACK_RATE_MAX=60
BNBHACK_RATE_WINDOW=60
# Comma-separated CORS allow-list for the backend.
BNBHACK_ALLOWED_ORIGINS=https://mefai.io
# Cache TTL (seconds) for the heavy compute endpoints.
BNBHACK_HEAVY_TTL=30

# ── x402 machine-payable feed ───────────────────────────────────────────────
BNBHACK_X402_NETWORK=bsc
BNBHACK_X402_ASSET=0x55d398326f99059fF775485246999027B3197955
BNBHACK_X402_ASSET_NAME=BSC-USD
BNBHACK_X402_ASSET_VERSION=1
BNBHACK_X402_PAYTO=
BNBHACK_X402_REQUIRE_SETTLEMENT=0
# Native x402 consumption: the agent itself buys the UVII index over x402.
BNBHACK_X402_CONSUME=1
BNBHACK_X402_PRODUCT=uvii-index
BNBHACK_X402_CONSUME_EVERY=30

# ── Trade feed · per-user Telegram bot DM fan-out (optional) ─────────────────
# Each trade leg is delivered to subscribers of @mefainews_bot. Fan-out endpoint
# (the push service) and its API key · leave the key blank if unused.
BNBHACK_AGENT_FEED_URL=
BNBHACK_AGENT_FEED_KEY=
# Optional direct Telegram bot (token + chat id); TELEGRAM_BOT_TOKEN is a legacy
# alias for the token. BNBHACK_TG_PAPER=1 also sends paper-mode legs.
BNBHACK_TG_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
BNBHACK_TG_CHAT_ID=
BNBHACK_TG_PAPER=1

# ── Watchdog (optional liveness monitor) ────────────────────────────────────
# systemd unit to watch, staleness/check/grace/cooldown seconds, alert webhook.
BNBHACK_WD_SERVICE=
BNBHACK_WD_STALE_SEC=300
BNBHACK_WD_CHECK_SEC=60
BNBHACK_WD_GRACE_SEC=120
BNBHACK_WD_COOLDOWN_SEC=900
BNBHACK_WD_ALERT_WEBHOOK=

# ── Trust Wallet Agent Kit CLI (optional, execution only) ───────────────────
TWAK_BIN=twak
TWAK_WALLET_PASSWORD=
