.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
node_modules
dist
build
.cache
*.log
*.db-journal
*.db-wal
*.db-shm
.env
.env.*
!.env.example
.DS_Store
.idea
.vscode
